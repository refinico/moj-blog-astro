---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header
	class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85"
>
	<nav
		class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4"
		aria-label="Nawigacja główna"
	>
		<a href="/" class="text-base font-bold tracking-tight text-slate-900 dark:text-white">
			{SITE_TITLE}
		</a>
		<div class="flex items-center gap-1 sm:gap-3">
			<HeaderLink href="/">Start</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">O mnie</HeaderLink>
			<ThemeToggle />
		</div>
	</nav>
</header>
