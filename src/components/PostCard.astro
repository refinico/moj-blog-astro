---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getCategory } from '../utils/posts';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const category = getCategory(post);
---

<a class="group flex flex-col" href={`/blog/${post.id}/`} data-post-tags={post.data.tags.join('|')}>
	<div class="relative aspect-[16/9] rounded-xl overflow-hidden mb-5 bg-muted">
		{post.data.heroImage ? (
			<Image
				src={post.data.heroImage}
				alt={post.data.title}
				width={720}
				height={405}
				class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
			/>
		) : (
			<div class="h-full w-full bg-gradient-to-br from-primary/60 to-accent"></div>
		)}
	</div>
	<span class="inline-block w-fit px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary/10 text-primary mb-3">
		{category}
	</span>
	<h3 class="text-lg font-semibold text-foreground leading-snug mb-2.5 group-hover:text-primary transition-colors duration-200 line-clamp-2">
		{post.data.title}
	</h3>
	<p class="text-sm text-muted-foreground mt-auto">
		<FormattedDate date={post.data.pubDate} />
	</p>
</a>
