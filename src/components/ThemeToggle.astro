---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<button
	type="button"
	data-theme-toggle
	aria-label="Przełącz motyw"
	title="Przełącz motyw"
	class:list={[
		'inline-flex cursor-pointer items-center justify-center rounded-xl border border-border bg-background text-muted-foreground transition-all duration-200 hover:scale-[0.98] hover:bg-accent hover:text-foreground active:scale-[0.90]',
		compact ? 'h-8 w-8' : 'h-10 w-10',
	]}
>
	<svg class="dark:hidden h-[1.4rem] w-[1.4rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
	</svg>
	<svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
	<span class="sr-only">Przełącz motyw</span>
</button>

<script>
	function syncLabels() {
		const isDark = document.documentElement.classList.contains('dark');
		const label = isDark ? 'Włącz jasny motyw' : 'Włącz ciemny motyw';
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
			button.setAttribute('aria-label', label);
			button.setAttribute('title', label);
		});
	}

	syncLabels();

	document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const root = document.documentElement;
			const next = root.classList.contains('dark') ? 'light' : 'dark';
			root.classList.remove('light', 'dark');
			root.classList.add(next);
			root.style.colorScheme = next;
			try {
				localStorage.setItem('blogs-theme', next);
			} catch (error) {
				// tryb prywatny — motyw działa do przeładowania
			}
			syncLabels();
		});
	});
</script>
