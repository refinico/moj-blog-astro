---
import type { CollectionEntry } from 'astro:content';
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	tags: string[];
	currentPage?: number;
	totalPages?: number;
	basePath?: string;
	id?: string;
}

const {
	posts,
	tags,
	currentPage = 1,
	totalPages = 1,
	basePath = '/all',
	id = 'post-explorer',
} = Astro.props;
---

<div class="sticky top-[4.5rem] z-40 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-3 bg-background/90 backdrop-blur-sm border-b border-border mb-10">
	<div class="flex items-center justify-between gap-4">
		<nav class="flex items-center gap-1 overflow-x-auto no-scrollbar" aria-label="Filtr kategorii" data-tag-bar>
			<button type="button" data-tag="" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors whitespace-nowrap bg-muted text-foreground">Wszystkie wpisy</button>
			{tags.map((tag) => (
				<button type="button" data-tag={tag} class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors whitespace-nowrap text-muted-foreground hover:text-foreground hover:bg-muted/50">{tag}</button>
			))}
		</nav>
		<div class="relative flex-shrink-0" data-search-wrap>
			<svg viewBox="0 0 24 24" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle>
			</svg>
			<input
				type="search"
				data-search
				placeholder="Szukaj..."
				aria-label="Szukaj wpisów"
				class="w-36 sm:w-48 lg:w-64 pl-9 pr-3 py-1.5 rounded-md bg-muted/50 border border-border text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring transition-all"
			/>
		</div>
	</div>
</div>

<p data-empty class="hidden py-16 text-center text-muted-foreground">Nie znaleziono wpisów. Spróbuj innej kategorii lub frazy.</p>

<div id={id} data-post-list class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 min-h-[50vh] mb-16">
	{posts.map((post) => <PostCard post={post} />)}
</div>

<Pagination {currentPage} {totalPages} {basePath} />

<script define:vars={{ explorerId: id }}>
	const list = document.getElementById(explorerId);
	const cards = list ? Array.from(list.querySelectorAll('[data-post-tags]')) : [];
	const buttons = Array.from(document.querySelectorAll('[data-tag-bar] [data-tag]'));
	const input = document.querySelector('[data-search]');
	const empty = document.querySelector('[data-empty]');

	function activeTag() {
		return new URLSearchParams(window.location.search).get('tag') || '';
	}

	function apply(tag, query) {
		const needle = query.trim().toLocaleLowerCase('pl');
		let visible = 0;
		for (const card of cards) {
			const tags = (card.getAttribute('data-post-tags') || '').split('|');
			const title = (card.querySelector('h3')?.textContent || '').toLocaleLowerCase('pl');
			const description = (card.querySelector('p')?.textContent || '').toLocaleLowerCase('pl');
			const show = (!tag || tags.includes(tag)) && (!needle || title.includes(needle) || description.includes(needle));
			card.classList.toggle('hidden', !show);
			if (show) visible++;
		}
		empty?.classList.toggle('hidden', visible > 0);
		for (const button of buttons) {
			const isActive = (button.getAttribute('data-tag') || '') === tag;
			button.classList.toggle('bg-muted', isActive);
			button.classList.toggle('text-foreground', isActive);
			button.classList.toggle('bg-transparent', !isActive);
			button.classList.toggle('text-muted-foreground', !isActive);
		}
	}

	function syncUrl() {
		const url = new URL(window.location.href);
		const tag = activeTag();
		const query = input?.value || '';
		if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
		if (query) url.searchParams.set('search', query); else url.searchParams.delete('search');
		window.history.replaceState(null, '', url);
	}

	for (const button of buttons) {
		button.addEventListener('click', () => {
			const tag = button.getAttribute('data-tag') || '';
			const url = new URL(window.location.href);
			if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
			window.history.replaceState(null, '', url);
			apply(activeTag(), input?.value || '');
		});
	}

	input?.addEventListener('input', () => {
		syncUrl();
		apply(activeTag(), input.value);
	});

	const initialQuery = new URLSearchParams(window.location.search).get('search') || '';
	if (input) input.value = initialQuery;
	apply(activeTag(), initialQuery);
</script>
