---
import type { CollectionEntry } from 'astro:content';
import PostExplorer from './PostExplorer.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	tags: string[];
	currentPage: number;
	totalPages: number;
	basePath?: string;
	id?: string;
}

const {
	posts,
	tags,
	currentPage,
	totalPages,
	basePath = '/all',
	id = 'all-posts-list',
} = Astro.props;
---

<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-12">
	<div class="mb-8">
		<a href="/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
			<svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7M19 12H5"></path></svg>
			Wstecz
		</a>
		<h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-foreground mb-3">Wszystkie wpisy o AI, modelach i kodowaniu</h1>
		<p class="text-base text-muted-foreground max-w-2xl leading-relaxed">
			Przeglądaj pełną kolekcję artykułów: analizy modeli, poradniki kodowania, narzędzia i praktyczne zastosowania sztucznej inteligencji.
		</p>
	</div>

	<PostExplorer {posts} {tags} {currentPage} {totalPages} {basePath} {id} />

	<div class="max-w-5xl mx-auto mb-24">
		<div class="relative overflow-hidden rounded-3xl bg-card border border-border shadow-lg">
			<div class="absolute -top-32 -right-32 w-96 h-96 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute -bottom-32 -left-32 w-96 h-96 bg-secondary/20 rounded-full blur-3xl pointer-events-none"></div>
			<div class="relative z-10 px-8 py-16 text-center max-w-4xl mx-auto">
				<div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-6">
					<svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m12 3 1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"></path>
					</svg>
					Dołącz do nas
				</div>
				<h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-4">Chcesz pisać o AI z nami?</h2>
				<p class="text-muted-foreground mb-8 max-w-xl mx-auto">
					Publikujemy gościnne artykuły, recenzje narzędzi i praktyczne poradniki. Napisz do nas, jeśli masz coś wartościowego do przekazania.
				</p>
				<a class="btn-primary" href="/partnerships">Zostań partnerem</a>
			</div>
		</div>
	</div>
</section>
