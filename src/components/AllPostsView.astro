---
import type { CollectionEntry } from 'astro:content';
import PostExplorer from './PostExplorer.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	tags: string[];
	currentPage: number;
	totalPages: number;
	basePath?: string;
	id?: string;
	title?: string;
	description?: string;
}

const {
	posts,
	tags,
	currentPage,
	totalPages,
	basePath = '/all',
	id = 'all-posts-list',
	title = 'Wszystkie wpisy o AI, modelach i kodowaniu',
	description = 'Przeglądaj pełną kolekcję artykułów: analizy modeli, poradniki kodowania, narzędzia i praktyczne zastosowania sztucznej inteligencji.',
} = Astro.props;
---

<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-12">
	<div class="mb-8">
		<a href="/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
			<svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7M19 12H5"></path></svg>
			Wstecz
		</a>
		<h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-foreground mb-3">{title}</h1>
		<p class="text-base text-muted-foreground max-w-2xl leading-relaxed">
			{description}
		</p>
	</div>

	<PostExplorer {posts} {tags} {currentPage} {totalPages} {basePath} {id} />
</section>
