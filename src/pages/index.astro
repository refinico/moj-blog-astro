---
import { Image } from 'astro:assets';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { collections, countPostsWithTag, formatArticleCount } from '../data/collections';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
const [featured, ...rest] = posts;
const latest = rest.slice(0, 3);
const allPosts = posts.slice(0, 9);

const collectionCards = collections.map((collection) => ({
	...collection,
	count: formatArticleCount(countPostsWithTag(posts, collection.tag)),
	href: `/kolekcje/${collection.slug}/`,
}));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1 class="sr-only">Najnowsze wpisy o AI, modelach i kodowaniu — Refinico AI Daily</h1>

	<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-14 lg:pt-16 lg:pb-20">
		{featured && <FeaturedPost post={featured} />}
	</section>

	<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 lg:pb-20">
		<div class="border-t border-border mb-10 lg:mb-12"></div>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
			{latest.map((post) => <PostCard post={post} />)}
		</div>
	</section>

	<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 lg:pb-12" id="all-posts">
		<div class="mb-10">
			<div class="flex items-center justify-between mb-6">
				<h2 class="text-xl lg:text-2xl font-bold tracking-tight text-foreground">Wszystkie wpisy</h2>
				<a href="/all" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary transition-colors duration-200">
					Zobacz wszystkie
					<svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
				</a>
			</div>
			<div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
				<a href="/all" class="whitespace-nowrap px-3.5 py-1.5 rounded-full text-sm font-medium transition-all duration-200 bg-foreground text-background">Wszystkie</a>
				{tags.map((tag) => (
					<a href={`/all?tag=${encodeURIComponent(tag)}`} class="whitespace-nowrap px-3.5 py-1.5 rounded-full text-sm font-medium transition-all duration-200 bg-muted text-muted-foreground hover:text-foreground hover:bg-muted/80">{tag}</a>
				))}
			</div>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
			{allPosts.map((post) => <PostCard post={post} />)}
		</div>

		<div class="flex justify-end mt-8 pt-5 border-t border-border">
			<a href="/all" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary transition-colors duration-200">
				Następna strona
				<svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
			</a>
		</div>
	</section>

	<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 lg:pb-16" id="collections">
		<div class="border-t border-border pt-10 lg:pt-12">
			<div class="flex items-center justify-between gap-4 mb-8">
				<div>
					<p class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground uppercase tracking-widest mb-2">
						<svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path>
							<path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path>
							<path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path>
						</svg>
						Przeglądaj tematy
					</p>
					<h2 class="text-xl lg:text-2xl font-bold tracking-tight text-foreground">Kolekcje</h2>
				</div>
				<a href="/all" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary transition-colors duration-200 whitespace-nowrap">
					Wszystkie artykuły
					<svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
				</a>
			</div>
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6">
				{collectionCards.map((collection) => (
					<a href={collection.href} class="group flex flex-col rounded-xl border border-border overflow-hidden bg-card hover:border-primary/40 hover:shadow-sm transition-all duration-200">
						<div class="relative aspect-[16/9] bg-muted overflow-hidden">
							<Image src={collection.image} alt={collection.title} width={480} height={270} class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]" />
						</div>
						<div class="p-4">
							<h3 class="font-semibold text-foreground group-hover:text-primary transition-colors">{collection.title}</h3>
							<p class="mt-1 text-xs text-muted-foreground">{collection.count}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
