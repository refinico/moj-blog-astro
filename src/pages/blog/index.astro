---
import AllPostsView from '../../components/AllPostsView.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts, paginate } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
const { items, totalPages } = paginate(posts, 1);
---

<BaseLayout title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<AllPostsView posts={items} {tags} currentPage={1} {totalPages} id="blog-posts-list" />
</BaseLayout>
