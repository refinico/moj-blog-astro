---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE } from '../consts';
import { getCategory, getReadingTime, type BlogPost } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	related: BlogPost[];
}

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const category = getCategory(post);
const readTime = getReadingTime(post);
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
---

<BaseLayout title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage?.src}>
	<div class="mx-auto max-w-[88rem] px-4 sm:px-6 lg:px-8 pt-10 lg:pt-14">
		<a href="/all" class="mb-8 inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors">
			<svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m12 19-7-7 7-7M19 12H5"></path>
			</svg>
			Wszystkie wpisy
		</a>

		<div class="mx-auto max-w-4xl">
			<div class="flex flex-wrap gap-2 mb-5">
				{tags.map((tag) => (
					<a href={`/all?tag=${encodeURIComponent(tag)}`} class="inline-flex items-center border border-transparent px-2 py-0.5 text-xs font-medium bg-primary/10 text-primary hover:bg-primary/20 rounded-md">{tag}</a>
				))}
			</div>

			<h1 id="blog-title" class="text-3xl md:text-5xl lg:text-5xl font-semibold tracking-tight text-foreground mb-6 leading-tight">
				{title}
			</h1>

			<div class="flex flex-wrap items-center justify-between gap-y-3 w-full mb-4">
				<div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
					<span class="flex items-center gap-1.5">
						<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M8 2v4M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path>
						</svg>
						<FormattedDate date={pubDate} />
					</span>
					<span class="flex items-center gap-1.5">
						<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
						</svg>
						{readTime} min czytania
					</span>
					{updatedDate && <span>Aktualizacja: <FormattedDate date={updatedDate} /></span>}
				</div>

				<div class="flex items-center gap-2">
					<span class="text-xs font-medium text-muted-foreground mr-1">Udostępnij:</span>
					<a href={xUrl} target="_blank" rel="noopener" title="Udostępnij na X" class="btn-icon h-9 w-9">
						<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
						</svg>
					</a>
					<a href={linkedInUrl} target="_blank" rel="noopener" title="Udostępnij na LinkedIn" class="btn-icon h-9 w-9">
						<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
							<rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle>
						</svg>
					</a>
					<button type="button" data-copy-link title="Kopiuj link" class="btn-icon h-9 w-9">
						<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
						</svg>
					</button>
				</div>
			</div>

			{heroImage && (
				<div class="relative aspect-[16/9] overflow-hidden rounded-2xl bg-muted mb-10">
					<Image src={heroImage} alt={title} width={1200} height={675} class="h-full w-full object-cover" />
				</div>
			)}

			<div class="relative flex justify-center xl:justify-start xl:justify-between gap-8">
				<aside class="hidden xl:block w-16 shrink-0">
					<div class="sticky top-[calc(100vh-16rem)]">
						<div class="flex flex-col items-center gap-1 p-2 rounded-2xl border border-border bg-background/80 backdrop-blur-sm shadow-sm">
							<span class="text-[9px] font-semibold tracking-widest text-muted-foreground uppercase py-1 select-none">Udostępnij</span>
							<a href={xUrl} target="_blank" rel="noopener" title="Udostępnij na X" class="flex h-9 w-9 items-center justify-center rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
							</a>
							<a href={linkedInUrl} target="_blank" rel="noopener" title="Udostępnij na LinkedIn" class="flex h-9 w-9 items-center justify-center rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
							</a>
							<button type="button" data-copy-link title="Kopiuj link" class="flex h-9 w-9 items-center justify-center rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
							</button>
						</div>
					</div>
				</aside>

				<div class="min-w-0 flex-1">
					<article class="article-prose">
						<slot />
					</article>
				</div>

				<div class="hidden xl:block w-16 shrink-0"></div>
			</div>
		</div>
	</div>

	<section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 mt-16 mb-20">
		<div class="flex items-center justify-between mb-6 border-b border-border pb-4">
			<div class="text-xl font-bold text-foreground">Może Ci się spodobać</div>
			<div class="flex items-center gap-2">
				<button type="button" data-related-prev disabled class="p-1.5 rounded-md border border-border hover:bg-muted disabled:opacity-40 transition">
					<svg viewBox="0 0 24 24" class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
				</button>
				<button type="button" data-related-next class="p-1.5 rounded-md border border-border hover:bg-muted disabled:opacity-40 transition">
					<svg viewBox="0 0 24 24" class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
				</button>
			</div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-related-track>
			{related.slice(0, 4).map((item) => <PostCard post={item} />)}
		</div>
	</section>

	<script define:vars={{ shareUrl }}>
		function copyLink() {
			try {
				navigator.clipboard.writeText(shareUrl);
				document.querySelectorAll('[data-copy-link]').forEach((button) => {
					const old = button.getAttribute('title');
					button.setAttribute('title', 'Skopiowano!');
					setTimeout(() => button.setAttribute('title', old || 'Kopiuj link'), 1500);
				});
			} catch (error) {
				// brak uprawnień do schowka
			}
		}
		document.querySelectorAll('[data-copy-link]').forEach((button) => button.addEventListener('click', copyLink));

		const track = document.querySelector('[data-related-track]');
		const cards = track ? Array.from(track.children) : [];
		const prev = document.querySelector('[data-related-prev]');
		const next = document.querySelector('[data-related-next]');
		let offset = 0;
		function update() {
			cards.forEach((card, index) => card.classList.toggle('hidden', index < offset || index >= offset + 2));
			if (prev) (prev as HTMLButtonElement).disabled = offset === 0;
			if (next) (next as HTMLButtonElement).disabled = offset >= cards.length - 2;
		}
		prev?.addEventListener('click', () => { offset = Math.max(0, offset - 1); update(); });
		next?.addEventListener('click', () => { offset = Math.min(cards.length - 2, offset + 1); update(); });
		update();
	</script>
</BaseLayout>
