# Adres kanoniczny używany do canonical / sitemap / RSS (ustawiany też w workflow).
SITE_URL=https://agentpmo.pl

# Google Tag Manager (z tagiem GA4 w kontenerze) — zalecany wariant.
# Pozostaw puste, aby nie ładować GTM.
PUBLIC_GTM_ID=GTM-XXXXXXX

# Alternatywa bez GTM: bezpośredni GA4 gtag.js. Używana tylko wtedy, gdy
# PUBLIC_GTM_ID jest puste. Pozostaw puste, aby nie ładować analytics.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
